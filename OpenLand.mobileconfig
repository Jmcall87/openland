	<key>PayloadDescription</key>
	<string>Installs the OpenLand app icon on your Home Screen. It only adds a shortcut to https://openland-ai.surge.sh. No device management, no data access. Remove anytime in Settings &gt; General &gt; VPN &amp; Device Management.</string>
	<key>PayloadDisplayName</key>
	<string>OpenLand</string>
	<key>PayloadIdentifier</key>
	<string>app.openland.profile</string>
	<key>PayloadOrganization</key>
	<string>OpenLand</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
